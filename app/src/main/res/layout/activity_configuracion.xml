<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_oscuro">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_configuracion"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/fondo_oscuro"
        app:title="Ajustes"
        app:titleTextColor="@color/rojo_primario"
        app:navigationIconTint="@color/rojo_primario"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar_configuracion"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nivel de insistencia de la IA"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/texto_principal" />

            <TextView
                android:id="@+id/tv_config_actual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nivel guardado: -"
                android:textSize="14sp"
                android:textColor="@color/rojo_suave"
                android:layout_marginTop="4dp" />

            <!-- Subtexto dinámico: explica el modo seleccionado -->
            <TextView
                android:id="@+id/tv_descripcion_nivel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Selecciona un nivel para ver cómo se comportarán las notificaciones."
                android:textSize="13sp"
                android:textColor="@color/texto_secundario"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp" />

            <RadioGroup
                android:id="@+id/rg_niveles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">

                <RadioButton android:id="@+id/rb_tranquilo" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="😇 Tranquilo" android:textSize="15sp" android:padding="8dp" android:buttonTint="@color/rojo_primario" android:textColor="@color/texto_principal" />
                <RadioButton android:id="@+id/rb_normal" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🙂 Normal" android:textSize="15sp" android:padding="8dp" android:buttonTint="@color/rojo_primario" android:textColor="@color/texto_principal" />
                <RadioButton android:id="@+id/rb_estricto" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="😤 Estricto" android:textSize="15sp" android:padding="8dp" android:buttonTint="@color/rojo_primario" android:textColor="@color/texto_principal" />
                <RadioButton android:id="@+id/rb_toxico" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🤬 Tóxico" android:textSize="15sp" android:padding="8dp" android:buttonTint="@color/rojo_primario" android:textColor="@color/texto_principal" />
            </RadioGroup>

            <!-- Explicación del motor de escalada -->
            <TextView
                android:id="@+id/tv_info_motor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📈 Motor de escalada progresiva: mientras más cerca esté la fecha límite, más notificaciones recibirás al día. En modo Estricto y Tóxico, si una tarea se vence, la app seguirá insistiendo hasta que la completes (con descanso entre 12:00 a.m. y 7:00 a.m.)."
                android:textSize="12sp"
                android:textColor="@color/texto_secundario"
                android:layout_marginTop="20dp"
                android:lineSpacingExtra="3dp" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/superficie_clara" android:layout_marginTop="24dp" android:layout_marginBottom="24dp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Notificaciones" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/texto_principal" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_notificaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Activar notificaciones push"
                android:textSize="15sp"
                android:textColor="@color/texto_principal"
                android:layout_marginTop="8dp"
                android:checked="true"
                app:thumbTint="@color/rojo_primario"
                app:trackTint="@color/superficie_clara" />

            <Button
                android:id="@+id/btn_guardar_config"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💾 Guardar cambios"
                android:backgroundTint="@color/rojo_primario"
                android:textColor="@color/texto_principal"
                android:layout_marginTop="32dp" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>