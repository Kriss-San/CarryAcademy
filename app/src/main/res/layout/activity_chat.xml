<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_oscuro">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_chat"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/fondo_oscuro"
        app:title="Chat"
        app:titleTextColor="@color/rojo_primario"
        app:navigationIconTint="@color/rojo_primario"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_mensajes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar_chat"
        app:layout_constraintBottom_toTopOf="@id/layout_typing"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/layout_typing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/scroll_adjuntos"
        app:layout_constraintStart_toStartOf="parent">

        <View android:layout_width="6dp" android:layout_height="6dp" android:background="@color/rojo_suave" android:layout_marginEnd="3dp" />
        <View android:layout_width="6dp" android:layout_height="6dp" android:background="@color/rojo_suave" android:layout_marginEnd="3dp" />
        <View android:layout_width="6dp" android:layout_height="6dp" android:background="@color/rojo_suave" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/scroll_adjuntos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/layout_input"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/contenedor_adjuntos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/layout_input"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/superficie_clara"
        android:padding="6dp"
        android:layout_margin="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btn_adjuntar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_mas"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:layout_gravity="center_vertical"
            android:contentDescription="Adjuntar"
            app:tint="@color/texto_secundario" />

        <EditText
            android:id="@+id/et_input_mensaje"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Pregúntale a CarryAcademy..."
            android:textColorHint="@color/texto_secundario"
            android:textColor="@color/texto_principal"
            android:padding="12dp"
            android:textSize="15sp"
            android:layout_gravity="center_vertical"
            android:inputType="textMultiLine"
            android:maxLines="4" />

        <ImageButton
            android:id="@+id/btn_enviar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_send"
            android:background="@drawable/circulo_avatar"
            android:padding="8dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="4dp"
            app:tint="@color/texto_principal"
            android:contentDescription="Enviar" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>